# ===============================
# Server
# ===============================
PORT=3000
NODE_ENV=development

# ===============================
# JWT
# ===============================
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
OTP_HMAC_SECRET=replace_with_a_dedicated_64_character_random_secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
# Number of trusted reverse-proxy hops between clients and this API.
TRUST_PROXY_HOPS=0

# ===============================
# Database (PostgreSQL service in Docker)
# ===============================
DB_USERNAME=postgres
DB_PASSWORD=postgres123
DB_DATABASE=mahder_db
DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/mahder_db
DATABASE_SCHEMA=public

# ===============================
# Redis
# ===============================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_new_64_character_redis_password
REDIS_URL=redis://:replace_with_a_new_64_character_redis_password@redis:6379

# ===============================
# RabbitMQ
# ===============================
RABBITMQ_USERNAME=mahder_app
RABBITMQ_PASSWORD=replace_with_a_new_rabbitmq_password
RABBITMQ_URI=amqp://mahder_app:replace_with_a_new_rabbitmq_password@rabbitmq:5672
RABBITMQ_QUEUE_NAME=notifications.queue
RABBITMQ_EXCHANGE_NAME=notifications.exchange
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_ROUTING_KEY=notification.created
RABBITMQ_DURABLE=true

DATASET_RABBITMQ_EXCHANGE_NAME=dataset.exchange
DATASET_RABBITMQ_QUEUE_NAME=dataset.queue
DATASET_RABBITMQ_ROUTING_KEY=dataset.action

# ===============================
# SMS Providers
# ===============================
SMS_BASE_URL=https://sms.com/api
SMS_IDENTIFIER=your_SMS_IDENTIFIER
SMS_SENDER=YourSenderName
SMS_TOKEN=your_afro_sms_token

# Afro SMS alternative provider
AFRO_SMS_API_KEY=your_afro_sms_api_key
AFRO_SMS_API_SECRET=your_afro_sms_api_secret

# ===============================
# MinIO
# ===============================
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minio_root_admin
MINIO_ROOT_PASSWORD=replace_with_a_long_random_root_password
MINIO_ACCESS_KEY=mahder_app_storage
MINIO_SECRET_KEY=replace_with_a_long_random_app_password
MINIO_BUCKET=mahder-bucket
MINIO_S3_FORCE_PATH_STYLE=true
MINIO_SIGNATURE_VERSION=v4
MINIO_API_BIND=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9001
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z

# ===============================
# Email
# ===============================
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password

# ===============================
# Santim Pay
# ===============================
SANTIM_PAY_PRODUCTION_BASE_URL=https://services.santimpay.com/api/v1/gateway
PAYMENT_BASE_URL=https://testnet.santimpay.com/api/v1/gateway
PAYMENT_MERCHANT_ID=your_merchant_id
PAYMENT_NOTIFY_URL=
# Leave callback URL empty while using status polling. Configure it only after implementing
# Santim Pay's documented callback signature verification.
# Store the PEM as a secret; never commit it to an environment file.
SANTIM_PAY_PRIVATE_KEY_IN_PEM=

# Keep disabled until withdrawal validation, atomic balance reservations, and settlement reconciliation are deployed.
ENABLE_WITHDRAWALS=false

# ===============================
# CORS
# ===============================
# Use comma-separated origins for multiple domains. Do not use * in production.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ===============================
# Demo seed data
# ===============================
# Set to true only for local development. Never enable this in production.
ENABLE_DEMO_USERS_SEED=false
DEMO_USERS_PASSWORD=

# ===============================
# Logging
# ===============================
LOG_LEVEL=debug
