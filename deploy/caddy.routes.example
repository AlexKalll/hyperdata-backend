# Add these routes to the active host Caddyfile (normally /etc/caddy/Caddyfile).
# Hyperdata publishes only loopback ports; do not expose these ports publicly.

mahder.duckdns.org {
    reverse_proxy 127.0.0.1:3001
}

mahder-api.duckdns.org {
    reverse_proxy 127.0.0.1:3000
}

mahder-storage.duckdns.org {
    reverse_proxy 127.0.0.1:9000
}
